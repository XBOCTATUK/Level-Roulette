{
	"geode": "5.2.0",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "xboctatuk.levels-roulette",
	"name": "Levels Roulette",
	"version": "v1.0.0",
	"developer": "xboctatuk",
	"description": "This mod adds a roulette button to the level search layer and allows you to try your unluck.",
	"settings": {
		"skips-count": {
			"name": "Skips count",
			"type": "int",
			"default": 3,
			"min": 0,
			"max": 10,
			"control": {
				"slider": true
			}
		},
		"list-editor-enabled": {
			"name": "List editor enabled",
			"description": "Enables the ability to create level lists",
			"type": "bool",
			"default": false
		}
	},
	"resources": {
		"sprites": [
			"resources/*.png"
		],
		"files": [
			"resources/levelData.json"
		]
	},
	"dependencies": {
		"geode.node-ids": ">=v1.22.0"
	},
	"tags": [
		"online",
		"content"
	]
}
